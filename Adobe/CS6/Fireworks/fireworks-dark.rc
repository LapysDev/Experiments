// The lowest numbered icon is Windows Explorer's executable icon.
101 ICON "Adobe Fireworks (Dark).ico"

// Only the running notification-area icon uses the alternate artwork.
102 ICON "Adobe Fireworks (Dark) (Alt.).ico"

#include <winver.h>

1 VERSIONINFO
 FILEVERSION 2,0,11,0
 PRODUCTVERSION 2,0,11,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Adobe Fireworks CS6 dark mode filter\0"
      VALUE "FileVersion", "2.0.11.0\0"
      VALUE "InternalName", "Fireworks-Dark\0"
      VALUE "OriginalFilename", "fireworks-dark.exe\0"
      VALUE "ProductName", "Adobe Fireworks CS6 (Dark)\0"
      VALUE "ProductVersion", "2.0.11.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
